<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kb.engine.mapper.KbChatMessageMapper">

    <resultMap id="KbChatMessageMap" type="com.kb.engine.entity.KbChatMessage">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="role" column="role"/>
        <result property="text" column="text"/>
        <result property="rewrittenQuery" column="rewritten_query"/>
        <result property="itemNames" column="item_names"
                typeHandler="org.apache.ibatis.type.StringTypeHandler"/>
        <result property="ts" column="ts"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO kb_chat_message (session_id, role, text, rewritten_query, item_names, ts)
        VALUES (#{sessionId}, #{role}, #{text}, #{rewrittenQuery},
                #{itemNames,jdbcType=VARCHAR}, #{ts})
    </insert>

    <select id="listBySessionId" resultMap="KbChatMessageMap">
        SELECT id, session_id, role, text, rewritten_query,
               CAST(item_names AS CHAR) AS item_names, ts
        FROM kb_chat_message
        WHERE session_id = #{sessionId}
        ORDER BY ts ASC, id ASC
    </select>

    <delete id="deleteBySessionId">
        DELETE FROM kb_chat_message WHERE session_id = #{sessionId}
    </delete>
</mapper>
