# 复制为 .env 后填写。不要把真实密钥提交到仓库。

# ---------- 大模型（DashScope 兼容 OpenAI）----------
# 代码里的 LLM / VLM 客户端读取下面三个变量
OPEN_API_KEY=sk-your-key
OPEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
# 导入流程里，图片摘要使用的视觉模型
VL_MODEL=qwen3-vl-flash

# ---------- PDF 解析（MinerU）----------
MINERU_API_TOKEN=your-mineru-token
MINERU_BASE_URL=https://mineru.net/api/v4

# ---------- 嵌入与重排序（本地模型目录）----------
# BGE-M3 本地路径，稠密向量维度为 1024
BGE_M3_PATH=D:/models/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=True
# 重排序模型与嵌入模型共用 BGE_DEVICE、BGE_FP16
BGE_RERANKER_LARGE=D:/models/bge-reranker-large
EMBEDDING_DIM=1024

# ---------- Milvus ----------
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks_v1
ITEM_NAME_COLLECTION=kb_item_names_v1

# ---------- MongoDB（对话历史）----------
MONGO_URL=mongodb://admin:123456@127.0.0.1:27017
MONGO_DB_NAME=kb001

# ---------- MinIO ----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-v1

# ---------- Web 搜索（查询流程，可按需填写）----------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
